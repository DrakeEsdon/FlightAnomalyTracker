# OpenSky Network credentials (https://opensky-network.org/my-opensky/account)
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# Collector (inside Docker, use kafka:9092 — only for local non-Docker runs)
KAFKA_BROKERS=localhost:9094
OPENSKY_POLL_INTERVAL_SECONDS=300

# Bounding box: lamin,lomin,lamax,lomax (US + Canada)
OPENSKY_BBOX=24.0,-141.0,84.0,-52.0
